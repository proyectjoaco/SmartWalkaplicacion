            android:strokeColor="#FFFFFF"
            android:strokeWidth="0.8"
            android:strokeAlpha="0.4"
            android:pathData="M0,-18 A18,18 0 1,1 -0.1,-18" />

        <!-- Head Silhouette -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,-15 C-6.6,-15 -12,-9.6 -12,-3 C-12,0.3 -10.7,3.3 -8.5,5.5 L-9,7 L-7.5,6.5 C-5.3,8.7 -2.3,10 1,10 C7.6,10 13,4.6 13,-2 C13,-8.6 7.6,-14 -1,-14 L0,-15 Z" />

        <!-- Walking Person Silhouette inside the head -->
